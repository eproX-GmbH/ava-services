{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ava/email-muster": [
        "../email-muster/src/index.ts"
      ],
      "@ava/ai-provider": [
        "../ai-provider/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
