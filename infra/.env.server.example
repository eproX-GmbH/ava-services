# Umgebung für den AVA-Server (infra/docker-compose.server.yml).
# Kopie als infra/.env.server anlegen; die Datei bleibt außerhalb von Git.

# 32 Byte als hex (64 Zeichen) oder base64: verschlüsselt Anmelde-Token und
# Schlüssel unter /data. Erzeugen: openssl rand -hex 32
AVA_SECRETS_KEY=

# Substrat (Vorgaben = Betrieb des Anbieters; für Self-Hosting die eigenen Adressen).
# GATEWAY_URL=https://ava-db-gateway.fly.dev
# AUTH_ISSUER=https://auth.ava.bi/realms/ava
# AUTH_CLIENT_ID=ava-desktop

# Modellanbieter: eigener Schlüssel für Chat, Hintergrund-KI und Producer.
# Alternativ im Chat (Telegram) hinterlegen; dann liegt er verschlüsselt unter /data.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Protokollstufe der Producer (debug|info|warn)
# LOGLEVEL=info
